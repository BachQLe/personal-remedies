# Supabase — Project Settings → API for both values below.
# Auth → URL Configuration must also be set in the Supabase dashboard:
#   Site URL: your app origin (e.g. http://localhost:5173 in dev, or your prod URL)
#   Redirect URLs: add "<origin>/auth/callback" for every origin you use (dev + prod)
# Auth → Providers → Google must be enabled with a valid Client ID/Secret for
# signInWithGoogle() to work.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Nutridigm API
VITE_NUTRIDIGM_BASE_URL=https://5jocnrfkfb.execute-api.us-east-1.amazonaws.com/PersonalRemedies/nutridigm/api/v2
VITE_NUTRIDIGM_SUBSCRIPTION_ID=your-subscription-id

# API source: 'live' | 'mock' (default: 'live')
# VITE_API_SOURCE=live
